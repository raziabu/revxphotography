<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= settings.studio_name || 'Studio' %></title>
<meta name="robots" content="<%= (typeof noindex !== 'undefined' && noindex) ? 'noindex, nofollow' : 'index, follow' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap">
<link rel="stylesheet" href="/style.css?v=<%= assetV %>">
<% if (settings.accent_color) { %><style>:root { --accent: <%= settings.accent_color %>; }</style><% } %>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%230e0e10'/><circle cx='16' cy='17' r='7' fill='none' stroke='%23d9b56b' stroke-width='2.5'/><rect x='6' y='8' width='20' height='3' rx='1.5' fill='%23d9b56b'/></svg>">
</head>
<body class="<%= (typeof admin !== 'undefined' && admin) ? 'is-admin' : '' %>">
<% if (typeof admin !== 'undefined' && admin) { %>
<header class="topbar">
  <a class="brand" href="/admin"><% if (settings.logo_file) { %><img class="brand-logo" src="/brand/logo?v=<%= settings.logo_file %>" alt="<%= settings.studio_name %>"><% } else { %><span class="brand-mark"></span><%= settings.studio_name || 'Studio' %><% } %> <span class="muted">/ admin</span></a>
  <nav class="topnav">
    <a href="/admin" class="<%= path === '/admin' || path.startsWith('/admin/galleries') ? 'active' : '' %>">Client galleries</a>
    <a href="/admin/portfolio" class="<%= path.startsWith('/admin/portfolio') || path.startsWith('/admin/albums') ? 'active' : '' %>">Portfolio</a>
    <a href="/admin/packages" class="<%= path.startsWith('/admin/packages') ? 'active' : '' %>">Packages</a>
    <a href="/admin/bookings" class="<%= path.startsWith('/admin/bookings') ? 'active' : '' %>">Bookings<% if (newBookings) { %> <span class="count"><%= newBookings %></span><% } %></a>
    <a href="/admin/settings" class="<%= path.startsWith('/admin/settings') ? 'active' : '' %>">Settings</a>
    <a href="/" target="_blank" rel="noopener">View site ↗</a>
    <form method="post" action="/admin/logout"><button class="linklike">Sign out</button></form>
  </nav>
</header>
<% } else { %>
<header class="topbar public">
  <a class="brand" href="/"><% if (settings.logo_file) { %><img class="brand-logo" src="/brand/logo?v=<%= settings.logo_file %>" alt="<%= settings.studio_name %>"><% } else { %><span class="brand-mark"></span><%= settings.studio_name || 'Studio' %><% } %></a>
  <nav class="topnav">
    <a href="/#work">Work</a>
    <a href="/#contact">Contact</a>
    <% if (typeof client !== 'undefined' && client) { %>
      <a href="/account" class="<%= path.startsWith('/account') ? 'active' : '' %>">My account</a>
    <% } else { %>
      <a href="/account/signin">Sign in</a>
    <% } %>
    <a href="/book" class="pill">Book a shoot</a>
    <% if (isAdmin) { %><a href="/admin" class="pill admin-pill">Admin</a><% } %>
  </nav>
</header>
<% } %>
<% if (flash) { %><div class="flash" role="status"><%= flash %></div><% } %>
<main class="page">
