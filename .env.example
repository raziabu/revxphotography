# Copy to .env and adjust. Everything is optional.

# Port the server listens on
PORT=3000

# Public address of the site (used for Stripe redirect URLs). Leave empty to auto-detect.
BASE_URL=

# Where uploads and the database live (default: ./data)
DATA_DIR=

# Max size of a single uploaded file in MB (default 4096 = 4 GB)
MAX_UPLOAD_MB=4096

# Set to 1 when the site is served over HTTPS (makes the admin cookie secure)
COOKIE_SECURE=0

# Stripe (optional). Can also be entered in Admin → Settings instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
