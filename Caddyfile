{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 8GB
    }
    reverse_proxy app:3000 {
        transport http {
            read_timeout 0
            write_timeout 0
        }
        flush_interval -1
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}
